# ---- Netlify environment variables (set these in Netlify, NOT in git) ----

# Supabase project URL, e.g. https://abcdefghijk.supabase.co
SUPABASE_URL=

# Supabase secret key (`sb_secret_...`), or a legacy service_role JWT.
# Server-side only. Never expose this to the browser, and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# The shared passcode leaders type to unlock editing.
EDIT_PASSCODE=

# ---- Local development only (optional) ----
# Passcode used when the app runs with no backend (plain `npm run dev`).
VITE_LOCAL_PASSCODE=yw2026
