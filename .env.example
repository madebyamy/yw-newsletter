# ---- Netlify environment variables (set these in Netlify, NOT in git) ----

# Supabase project URL, e.g. https://abcdefghijk.supabase.co
SUPABASE_URL=

# Supabase secret key (`sb_secret_...`), or a legacy service_role JWT.
# Server-side only. Never expose this to the browser, and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# The shared passcode leaders type to unlock editing.
EDIT_PASSCODE=

# ---- Activity schedule (optional) ----

# Published Google Sheet holding the ward activity schedule. Either the
# /pubhtml browser URL or the /pub?output=csv form works.
# Only the first two columns are read: the date and the activity name.
ACTIVITY_SHEET_CSV_URL=

# The year the first rows of that tab belong to. The parser rolls forward on
# its own when the months wrap past December.
ACTIVITY_SHEET_YEAR=2026

# ---- Local development only (optional) ----
# Passcode used when the app runs with no backend (plain `npm run dev`).
VITE_LOCAL_PASSCODE=yw2026
